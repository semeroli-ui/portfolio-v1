# ============================================================
#  Cloudflare Pages — Environment Variables
#  配置路径: Workers & Pages → 你的项目 → Settings → Variables
# ============================================================

# ── 管理员凭据 ─────────────────────────────────────────────

# 管理员用户名（建议修改，不要使用默认）
ADMIN_USERNAME=admin

# 密码 bcrypt 哈希值（不是明文密码！）
# 生成方式（需 Node.js >= 18）：
#   node -e "import('bcryptjs').then(m=>m.default.hash('你的密码',10).then(h=>console.log(h)))"
# 示例（仅演示格式，请替换为你的实际哈希）：
ADMIN_PASSWORD_HASH=$2a$10$XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX

# ── JWT 配置 ─────────────────────────────────────────────

# JWT 签名密钥。必须 >= 32 个字符。
# 推荐使用随机字符串生成：
#   node -e "console.log(crypto.randomBytes(48).toString('hex'))"
# ⚠️  生产环境请务必修改为此处生成的真实随机值！
JWT_SECRET=请在此填入至少32字符的随机字符串

# ── KV Namespace ─────────────────────────────────────────
# RATE_LIMIT_KV: 用于速率限制计数和刷新令牌存储
# 在 Cloudflare Dashboard → Workers & Pages → 你的项目 → Settings → KV Namespaces
# 创建一个名为 "RATE_LIMIT_KV" 的 Namespace，绑定到 production 环境，
# 变量名填写 "RATE_LIMIT_KV"
